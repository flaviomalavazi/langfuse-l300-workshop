# Copy to `.env` and fill in.
#
# Langfuse Cloud project keys — Settings → API Keys → "Create new API keys".
# Use the same project for all four demos so the traces, datasets, scores
# and queue items show up together.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Pick the host that matches your project region.
#   US:   https://us.cloud.langfuse.com
#   EU:   https://cloud.langfuse.com
#   self: https://langfuse.your-domain.tld
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenAI key — Demos 1, 2, 3 call gpt-4o-mini.
OPENAI_API_KEY=sk-...

# Demo 4 only — copy from the Langfuse UI: Annotation Queues → your queue.
# Leave blank until you have created the queue.
LANGFUSE_QUEUE_ID=
