# Langfuse credentials (Settings → API Keys in the Langfuse UI)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenAI key used by the candidate systems and the judge
OPENAI_API_KEY=sk-...

# Models
SYSTEM_A_MODEL=gpt-4o-mini
SYSTEM_B_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1

# Names of the two systems and the dataset
SYSTEM_A_NAME=concise-baseline
SYSTEM_B_NAME=detailed-cot
DATASET_NAME=pairwise-demo
